SPRING_PROFILES_ACTIVE=prod

# Issuer público do NimbusAuth (enviado ao browser em /oauth2/authorize) - mesmo domínio já usado
# pelo CardsyncServer/CardSyncWeb.
NIMBUS_AUTH_ISSUER=https://auth.nimbussystems.com.br

# NÃO USADA em produção (ver application-prod.yml) - token/jwk-set/user-info/nimbusauth.base-url
# usam NIMBUS_AUTH_ISSUER (URL pública), mesmo padrão do CardsyncServer. A ideia original era usar
# a rede privada do Railway aqui pra chamadas backend->backend (mais rápido, não passa pela
# Cloudflare), mas isso nunca funcionou de fato em produção (hostname/porta interno incorretos ou
# private networking não habilitado entre os serviços) - toda chamada de token/jwk-set/user-info
# falhava (502/504 em /bff/v1/me/profile). Só usada localmente (default http://localhost:9090 em
# application-dev.yml) - fica aqui só como referência caso alguém reative a rede privada no futuro.
NIMBUS_AUTH_INTERNAL_BASE_URL=http://nimbus-auth.railway.internal:8080

# Secret compartilhado da API interna machine-to-machine do NimbusAuth (/internal/**, ver
# NimbusAuthInternalClient) - usado tanto pra resolver nome/username de usuário quanto pelo
# backup sob demanda (GET /internal/backup/database, ver common/backup/BackupService). Precisa
# ser IDÊNTICO ao NIMBUS_INTERNAL_API_SECRET já configurado no serviço do NimbusAuth no Railway
# (mesmo valor usado pelo CardsyncServer/NimbusFlowServer/NimbusNovaxServer).
NIMBUS_INTERNAL_API_SECRET=change-me

NIMBUSDESK_BFF_CLIENT_ID=nimbusdesk-bff
# Precisa ser IDÊNTICO ao NIMBUSDESK_BFF_CLIENT_SECRET setado no serviço do NimbusAuth.
NIMBUSDESK_BFF_CLIENT_SECRET=change-me

# Domínio PAI compartilhado com a SPA (não o do próprio NimbusDeskServer!) - obrigatório, sem
# default. Mesmo motivo documentado no CardsyncServer: o cookie XSRF-TOKEN precisa ser legível via
# document.cookie pelo JS da SPA (desk.nimbussystems.com.br), o que só funciona se o Domain do
# cookie cobrir os dois hosts - usar o host específico do backend aqui (desk-api...) quebra todo
# POST/PUT/PATCH/DELETE da SPA em produção com 403 "Invalid CSRF Token 'null'".
NIMBUSDESK_COOKIE_DOMAIN=nimbussystems.com.br
NIMBUSDESK_COOKIE_SECURE=true
NIMBUSDESK_COOKIE_SAMESITE=Lax

NIMBUSDESK_RESOURCE_SERVER_ENABLED=true

NIMBUSDESK_SPA_BASE_URL=https://desk.nimbussystems.com.br
NIMBUSDESK_ALLOWED_ORIGIN=https://desk.nimbussystems.com.br

SPRING_DATASOURCE_URL=jdbc:postgresql://<PGHOST>:<PGPORT>/<PGDATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=<PGUSER>
SPRING_DATASOURCE_PASSWORD=<PGPASSWORD>

# Config de e-mail (com.nimbusdesk.common.notification.mail) - TODAS opcionais, com default
# seguro "fake" (só loga, não envia nada de verdade). Mesmo padrão de NimbusFlow/CardSync: não
# configurar Brevo aqui via env var - ativar de verdade só pela tela Configurações > E-mail
# (EmailSettingsService sobrescreve em runtime, sem precisar de novo deploy). Trocar
# NIMBUSDESK_EMAIL_IMPL pra "api_key" aqui só serviria de fallback caso ninguém configure pela
# tela - a chave certa seria a da aba "API Keys" do Brevo (Settings -> SMTP & API), NÃO "SMTP".
NIMBUSDESK_EMAIL_IMPL=fake
NIMBUSDESK_EMAIL_FROM_NAME=NimbusDesk
NIMBUSDESK_EMAIL_FROM_EMAIL=naoresponda@nimbussystems.com.br
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=

# Opcional - já tem default certo em application-prod.yml (https://desk-api.nimbussystems.com.br).
# com.nimbussystems.commons.notification.mail.EmailProperties#publicBaseUrl - trocar aqui só se o
# domínio de produção mudar.
NIMBUSDESK_API_PUBLIC_BASE_URL=https://desk-api.nimbussystems.com.br

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport
